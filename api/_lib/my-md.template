.file-input { display: none; }
.search-input { width: 100%; padding: 9px 10px; border: 1px solid #d0d7de; border-radius: 6px; font-size: 14px; margin-bottom: 12px; outline: none; }
.search-input:focus { border-color: #0969da; box-shadow: 0 0 0 3px rgba(9,105,218,.12); }
.current-path { font-size: 13px; color: #57606a; word-break: break-all; margin-bottom: 0; padding: 6px 8px; background: #f6f8fa; border-radius: 6px; display: none; align-items: center; justify-content: space-between; gap: 8px; }
.root-toggle { flex: 1; min-width: 0; cursor: pointer; user-select: none; font-weight: 600; }
.root-toggle::before { content: '▾'; display: inline-block; width: 14px; margin-right: 4px; transition: transform .15s ease; }
.root-toggle.collapsed::before { transform: rotate(-90deg); }
.remove-root { border: 0; background: transparent; color: #57606a; font-size: 16px; line-height: 1; cursor: pointer; padding: 2px 4px; border-radius: 4px; flex-shrink: 0; }
.remove-root:hover { background: #eaeef2; color: #cf222e; }
.row-sort-btn { border: 1px solid #d0d7de; background: #fff; color: #57606a; font-size: 11px; font-weight: 500; line-height: 1; cursor: pointer; padding: 2px 6px; border-radius: 4px; display: inline-flex; align-items: center; gap: 3px; transition: all .15s ease; flex-shrink: 0; user-select: none; }
.row-sort-btn:hover { background: #f3f4f6; color: #0969da; border-color: #0969da; }
.row-sort-btn svg { display: inline-block; vertical-align: middle; }
.folder-row { display: flex; align-items: center; justify-content: space-between; width: 100%; border-radius: 6px; }
.folder-row .folder { flex: 1; min-width: 0; }
.file-row { display: flex; align-items: center; justify-content: space-between; width: 100%; border-radius: 6px; }
.file-row a { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.file-copy-btn { border: 0; background: transparent; color: #57606a; width: 24px; height: 24px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; opacity: 0; transition: opacity .15s ease, background .15s ease, color .15s ease; user-select: none; }
.file-row:hover .file-copy-btn, .file-row a.active ~ .file-copy-btn, .file-copy-btn:focus, .file-copy-btn.copied { opacity: 1; }
.file-copy-btn:hover { background: #eaeef2; color: #0969da; }
.file-row a.active ~ .file-copy-btn { color: #fff; }
