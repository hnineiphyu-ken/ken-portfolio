<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KEN'S-MD</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; height: 100vh; background: #f5f6f8; color: #24292f; }
.sidebar { width: 320px; height: 100vh; background: #fff; border-right: 1px solid #e1e4e8; overflow: hidden; padding: 0 16px 14px; flex-shrink: 0; display: flex; flex-direction: column; }
.sidebar-header { position: sticky; top: 0; z-index: 2; background: #fff; padding: 20px 0 4px; box-shadow: 0 8px 12px rgba(255,255,255,.95); }
.sidebar-title-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
.sidebar h1 { font-size: 18px; color: #24292f; }
.sidebar-close-btn { width: 28px; height: 28px; border: 0; border-radius: 6px; background: #f6f8fa; color: #57606a; font-size: 18px; line-height: 1; cursor: pointer; flex-shrink: 0; }
.sidebar-close-btn:hover { background: #eaeef2; color: #cf222e; }
.open-btn { width: 100%; padding: 10px; background: #0969da; color: #fff; border: 0; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; margin-bottom: 12px; }
.open-btn:hover { background: #0b5fbf; }
.open-actions { display: flex; gap: 8px; margin-bottom: 12px; }
.open-actions .open-btn { flex: 1; width: auto; margin-bottom: 0; padding: 10px 8px; }
.open-file-btn { background: #57606a; }
.open-file-btn:hover { background: #424a53; }
.file-input { display: none; }
.search-input { width: 100%; padding: 9px 10px; border: 1px solid #d0d7de; border-radius: 6px; font-size: 14px; margin-bottom: 12px; outline: none; }
.search-input:focus { border-color: #0969da; box-shadow: 0 0 0 3px rgba(9,105,218,.12); }
.current-path { font-size: 13px; color: #57606a; word-break: break-all; margin-bottom: 0; padding: 6px 8px; background: #f6f8fa; border-radius: 6px; display: none; align-items: center; justify-content: space-between; gap: 8px; }
.root-toggle { flex: 1; min-width: 0; cursor: pointer; user-select: none; font-weight: 600; }
.root-toggle::before { content: '▾'; display: inline-block; width: 14px; margin-right: 4px; transition: transform .15s ease; }
.root-toggle.collapsed::before { transform: rotate(-90deg); }
.remove-root { border: 0; background: transparent; color: #57606a; font-size: 16px; line-height: 1; cursor: pointer; padding: 2px 4px; border-radius: 4px; flex-shrink: 0; }
.remove-root:hover { background: #eaeef2; color: #cf222e; }
.tree { list-style: none; flex: 1; min-height: 0; overflow-y: auto; padding-bottom: 10px; }
.tree.collapsed { display: none; }
.tree li { margin: 2px 0; }
.tree .root-item.dragging { opacity: .55; }
.tree .root-item.drop-before { border-top: 3px solid #0969da; padding-top: 3px; }
.tree .root-item.drop-after { border-bottom: 3px solid #0969da; padding-bottom: 3px; }
.tree .root-row { font-size: 13px; color: #57606a; word-break: break-all; margin: 8px 0 4px; padding: 6px 8px; background: #f6f8fa; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.tree .root-row.selected { background: #e7f2ff; color: #075985; border: 1px solid #b6d7f5; }
.tree .single-file-row a { flex: 1; min-width: 0; }
.tree a { color: #24292f; text-decoration: none; font-size: 14px; display: block; padding: 4px 8px; border-radius: 6px; cursor: pointer; }
.tree a:hover { background: #f0f1f3; }
.tree a.active { background: #0969da; color: #fff; }
.tree .folder { font-weight: 600; padding: 4px 8px; color: #57606a; font-size: 13px; text-transform: uppercase; letter-spacing: .03em; user-select: none; cursor: pointer; border-radius: 6px; }
.tree .folder:hover { background: #f0f1f3; }
.tree .folder.selected-parent { background: #eaeef2; color: #424a53; }
.tree .folder::before { content: '▾'; display: inline-block; width: 14px; margin-right: 4px; transition: transform .15s ease; }
.tree .folder.collapsed::before { transform: rotate(-90deg); }
.tree .children { list-style: none; padding-left: 14px; border-left: 1px solid #e1e4e8; margin-left: 10px; }
.tree .children.collapsed { display: none; }
.tree .file-icon { opacity: .7; margin-right: 4px; }
.developer-credit { color: #57606a; font-size: 12px; text-align: center; background: #fff; border-top: 1px solid #e1e4e8; padding-top: 10px; flex-shrink: 0; }
.main { flex: 1; overflow-y: auto; padding: 32px 40px; }
.empty { color: #57606a; font-size: 16px; max-width: 600px; }
.error { color: #cf222e; background: #ffebe9; border: 1px solid #ffcecb; padding: 12px 16px; border-radius: 6px; font-size: 14px; word-break: break-all; }
.hint { font-size: 13px; color: #57606a; margin-top: 12px; line-height: 1.6; }
.loading { color: #57606a; background: #fff; border: 1px solid #e1e4e8; border-radius: 8px; padding: 24px 28px; display: inline-flex; align-items: center; gap: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
.spinner { width: 18px; height: 18px; border: 3px solid #d0d7de; border-top-color: #0969da; border-radius: 50%; animation: spin .75s linear infinite; flex-shrink: 0; }
@keyframes spin { to { transform: rotate(360deg); } }
.markdown { width: 100%; background: #fff; border: 1px solid #e1e4e8; border-radius: 8px; padding: 32px 40px; box-shadow: 0 1px 3px rgba(0,0,0,.04); line-height: 1.7; }
.markdown h1, .markdown h2, .markdown h3, .markdown h4 { margin: 28px 0 14px; line-height: 1.25; }
.markdown h1:first-child { margin-top: 0; }
.markdown p { margin: 0 0 16px; }
.markdown ul, .markdown ol { margin: 0 0 16px; padding-left: 28px; }
.markdown li { margin: 4px 0; }
.markdown code { background: #f0f1f3; padding: 2px 6px; border-radius: 4px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 13px; }
.markdown pre { background: #f6f8fa; border: 1px solid #e1e4e8; border-radius: 6px; padding: 16px; overflow-x: auto; margin: 0 0 16px; }
.markdown pre code { background: transparent; padding: 0; }
.markdown blockquote { border-left: 4px solid #d0d7de; margin: 0 0 16px; padding: 0 16px; color: #57606a; }
.markdown a { color: #0969da; }
.markdown table { border-collapse: collapse; margin: 0 0 16px; }
.markdown th, .markdown td { border: 1px solid #d0d7de; padding: 6px 12px; }
.markdown img { max-width: 100%; }
.markdown hr { border: 0; border-top: 1px solid #e1e4e8; margin: 24px 0; }
.markdown del { color: #57606a; }
.markdown img { max-width: 100%; height: auto; border-radius: 6px; margin: 8px 0; }
.markdown .task-list { list-style: none; padding-left: 4px; }
.markdown .task-list li { display: flex; align-items: flex-start; gap: 8px; margin: 6px 0; }
.markdown .task-list input[type="checkbox"] { margin-top: 5px; accent-color: #0969da; flex-shrink: 0; }
.markdown .footnotes { margin-top: 32px; padding-top: 16px; border-top: 1px solid #e1e4e8; font-size: 14px; color: #57606a; }
.markdown .footnotes h2 { font-size: 16px; margin-bottom: 8px; }
.markdown .footnotes ol { padding-left: 24px; }
.markdown .footnotes li { margin: 4px 0; }
.markdown .footnote-ref { font-size: 12px; vertical-align: super; color: #0969da; text-decoration: none; }
.markdown .footnote-ref:hover { text-decoration: underline; }
.markdown .mermaid { background: #f6f8fa; border: 1px solid #e1e4e8; border-radius: 8px; padding: 16px; margin: 0 0 16px; text-align: center; overflow-x: auto; }
.markdown .mermaid svg { max-width: 100%; }
.markdown .mermaid-error { color: #cf222e; background: #ffebe9; border-color: #ffcecb; text-align: left; white-space: pre-wrap; }
.menu-btn { display: none; position: fixed; top: 14px; left: 14px; z-index: 5; width: 42px; height: 42px; border: 1px solid #d0d7de; border-radius: 8px; background: #fff; color: #24292f; font-size: 22px; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
.sidebar-overlay { display: none; position: fixed; inset: 0; z-index: 3; background: rgba(31,35,40,.36); }
body.sidebar-closed .sidebar { display: none; }
body.sidebar-closed .menu-btn { display: block; }
body.sidebar-closed .main { padding: 72px 40px 32px 88px; }
@media (max-width: 1023px) {
body { display: block; }
.menu-btn { display: block; }
.sidebar { position: fixed; top: 0; left: 0; z-index: 4; width: min(320px, 86vw); transform: translateX(-100%); transition: transform .22s ease; box-shadow: 8px 0 24px rgba(31,35,40,.18); }
body.sidebar-closed .sidebar { display: flex; }
body.sidebar-open .sidebar { transform: translateX(0); }
body.sidebar-open .sidebar-overlay { display: block; }
body.sidebar-open .menu-btn { display: none; }
.main { min-height: 100vh; padding: 72px 18px 28px; }
.markdown { padding: 24px 20px; }
}
.reader-actions { display: flex; gap: 8px; margin-bottom: 12px; }
.reader-actions .open-btn { flex: 1; margin: 0; }
.logout-link { display: inline-flex; align-items: center; padding: 0 10px; border: 1px solid #d0d7de; border-radius: 6px; color: #57606a; font-size: 13px; text-decoration: none; }
.logout-link:hover { background: #f6f8fa; color: #cf222e; }
.repository-name, .document-path { color: #57606a; font-size: 12px; word-break: break-all; }
.repository-name { padding: 8px; background: #f6f8fa; border-radius: 6px; }
.document-path { margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #e1e4e8; }
.loading-row { color: #57606a; font-size: 13px; padding: 10px 8px; }
</style>
</head>
<body>
<button class="menu-btn" id="menuBtn" type="button" aria-label="Open sidebar">☰</button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<aside class="sidebar">
  <div class="sidebar-header">
    <div class="sidebar-title-row">
      <h1>Hachiware Reader</h1>
      <button class="sidebar-close-btn" id="sidebarCloseBtn" type="button" aria-label="Close sidebar">☰</button>
    </div>
    <div class="reader-actions">
      <button class="open-btn" id="refreshBtn" type="button">Refresh</button>
      <a class="logout-link" href="/api/auth/logout">Sign out</a>
    </div>
    <input class="search-input" id="searchInput" type="search" placeholder="Search Markdown files…" aria-label="Search Markdown files">
    <div class="repository-name" id="repository">Loading private repository…</div>
  </div>
  <ul class="tree" id="tree"></ul>
  <div class="developer-credit">Private · Hachiware</div>
</aside>
<main class="main" id="main">
  <div class="loading"><span class="spinner" aria-hidden="true"></span><span>Loading private Markdown files…</span></div>
</main>
<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
<script src="/assets/js/hachiware-reader.js"></script>
</body>
</html>
