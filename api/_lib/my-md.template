}
.reader-actions { display: flex; gap: 8px; margin-bottom: 12px; }
.reader-actions .open-btn { flex: 1; margin: 0; }
.logout-link { display: inline-flex; align-items: center; padding: 0 10px; border: 1px solid #d0d7de; border-radius: 6px; color: #57606a; font-size: 13px; text-decoration: none; }
.logout-link:hover { background: #f6f8fa; color: #cf222e; }
.repository-name { color: #57606a; font-size: 12px; word-break: break-all; padding: 8px; background: #f6f8fa; border-radius: 6px; }
.quick-reports { container: quick-reports / inline-size; margin: 0 0 18px; border: 1px solid #d0d7de; border-radius: 8px; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.04); overflow: clip; }
.quick-reports[hidden] { display: none; }
