.quick-reports-toggle { width: 100%; border: 0; background: transparent; padding: 10px 14px; min-block-size: 42px; display: flex; align-items: center; justify-content: space-between; gap: 10px; cursor: pointer; color: #24292f; font-size: 13px; font-weight: 600; text-align: left; }
