.document-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 12px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #e1e4e8; }
.document-path { font-size: 13px; font-weight: 500; color: #57606a; word-break: break-all; display: flex; align-items: center; gap: 6px; flex: 1 1 200px; min-width: 0; }
.document-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; flex-shrink: 0; }
.doc-date-nav { display: inline-flex; align-items: center; gap: 4px; }
.doc-nav-btn { display: inline-flex; align-items: center; gap: 4px; padding: 5px 10px; min-block-size: 28px; font-size: 12px; font-weight: 500; color: #24292f; background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 6px; cursor: pointer; line-height: 1; transition: all .15s ease; user-select: none; }
.doc-nav-btn:hover:not([aria-disabled="true"]) { background: #f3f4f6; border-color: #0969da; color: #0969da; }
.doc-nav-btn:active:not([aria-disabled="true"]) { scale: 0.97; }
.doc-nav-btn[aria-disabled="true"] { color: #8c959f; background: #f6f8fa; cursor: not-allowed; opacity: .7; }
.doc-copy-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; min-block-size: 28px; font-size: 12px; font-weight: 500; color: #24292f; background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 6px; cursor: pointer; line-height: 1; transition: all .15s ease; user-select: none; flex-shrink: 0; }
.doc-copy-btn:hover { background: #f3f4f6; border-color: #0969da; color: #0969da; }
.doc-copy-btn.copied { color: #1a7f37; border-color: #1a7f37; background: #dafbe1; font-weight: 600; }
.doc-copy-btn svg { display: inline-block; vertical-align: middle; flex-shrink: 0; }
.code-block { position: relative; margin: 0 0 16px; }
.code-block pre { margin: 0; }
.code-copy-btn { position: absolute; top: 8px; right: 8px; z-index: 1; display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; font-size: 11px; font-weight: 500; color: #57606a; background: #fff; border: 1px solid #d0d7de; border-radius: 4px; cursor: pointer; opacity: 0; transition: opacity .15s ease, background .15s ease, color .15s ease; user-select: none; line-height: 1; }
.code-block:hover .code-copy-btn, .code-copy-btn:focus-visible, .code-copy-btn.copied { opacity: 1; }
.code-copy-btn:hover { background: #f3f4f6; color: #0969da; border-color: #0969da; }
.code-copy-btn.copied { color: #1a7f37; border-color: #1a7f37; background: #dafbe1; }
.code-copy-btn svg { display: inline-block; vertical-align: middle; flex-shrink: 0; }
:where(button, a, .quick-date-input):focus-visible { outline: 2px solid #0969da; outline-offset: 2px; }
@media (hover: none) {
.file-copy-btn, .code-copy-btn { opacity: 1; }
}
@media (pointer: coarse) {
.quick-reports-toggle { min-block-size: 44px; }
.quick-view-tab { min-block-size: 44px; font-size: 13px; }
.quick-filter-row { grid-template-columns: 1fr; }
.quick-date-input { font-size: max(1rem, 1em); min-block-size: 44px; padding: 8px 10px; }
.quick-filter-clear { min-block-size: 44px; padding: 8px 12px; font-size: 13px; }
.quick-pager-btn, .quick-period-btn { min-block-size: 44px; min-inline-size: 44px; padding: 8px 10px; font-size: 13px; }
.quick-cal-day { min-block-size: 44px; font-size: 12.5px; }
.quick-date-btn { min-block-size: 44px; padding: 8px 10px; }
.doc-copy-btn, .doc-nav-btn { min-block-size: 44px; padding: 8px 12px; }
}
.loading-row { color: #57606a; font-size: 13px; padding: 10px 8px; }
</style>
</head>
<body>
<button class="menu-btn" id="menuBtn" type="button" aria-label="Open sidebar" aria-controls="sidebar" aria-expanded="false">☰</button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div class="sidebar-title-row">
      <h1>Hachiware Reader</h1>
      <button class="sidebar-close-btn" id="sidebarCloseBtn" type="button" aria-label="Close sidebar">☰</button>
    </div>
    <div class="reader-actions">
      <button class="open-btn" id="refreshBtn" type="button">Refresh</button>
      <a class="logout-link" href="/api/auth/logout">Sign out</a>
    </div>
    <input class="search-input" id="searchInput" type="search" placeholder="Search Markdown files…" aria-label="Search Markdown files">
    <div class="repository-name" id="repository">Loading private repository…</div>
  </div>
  <ul class="tree" id="tree"></ul>
  <div class="developer-credit">Private · Hachiware</div>
</aside>
<main class="main" id="main">
  <section class="quick-reports" id="quickReports" aria-label="Daily Reports" hidden>
    <h2 class="quick-reports-heading">
      <button class="quick-reports-toggle" id="quickReportsToggle" type="button" aria-expanded="false" aria-controls="quickReportsBody">
        <span class="quick-reports-title-wrap"><span class="quick-reports-chevron" aria-hidden="true">▾</span><span>Daily Reports</span><span class="quick-reports-count" id="quickReportsCount">0</span></span>
        <span class="quick-reports-summary" id="quickReportsSummary">List (5)</span>
      </button>
    </h2>
    <div class="quick-reports-body" id="quickReportsBody" hidden>
      <div class="quick-controls-bar">
        <div class="quick-view-tabs" id="quickViewTabs" role="tablist" aria-label="Daily reports view">
          <button class="quick-view-tab" id="quickTabList" type="button" role="tab" data-quick-view="list" aria-selected="true" tabindex="0">List (5)</button>
          <button class="quick-view-tab" id="quickTabWeek" type="button" role="tab" data-quick-view="week" aria-selected="false" tabindex="-1">Week</button>
          <button class="quick-view-tab" id="quickTabMonth" type="button" role="tab" data-quick-view="month" aria-selected="false" tabindex="-1">Month</button>
        </div>
        <search class="quick-reports-filter" aria-label="Filter daily reports by date range">
          <div class="quick-filter-row">
            <div class="quick-filter-field">
              <label class="quick-filter-label" for="reportDateFrom">From</label>
              <input class="quick-date-input" id="reportDateFrom" name="report_from" type="date" aria-describedby="reportFilterStatus">
            </div>
            <div class="quick-filter-field">
              <label class="quick-filter-label" for="reportDateTo">To</label>
              <input class="quick-date-input" id="reportDateTo" name="report_to" type="date" aria-describedby="reportFilterStatus">
            </div>
          </div>
          <div class="quick-filter-actions" id="quickFilterActions" hidden>
            <span class="quick-filter-status" id="reportFilterStatus" role="status" aria-live="polite"></span>
            <button class="quick-filter-clear" id="reportFilterClear" type="button" hidden>Clear dates</button>
          </div>
        </search>
      </div>
      <div class="quick-view-panel" id="quickPanelList" role="tabpanel" aria-labelledby="quickTabList">
        <ul class="quick-reports-list" id="quickReportsList" role="list"></ul>
        <nav class="quick-pager" id="quickListPagination" aria-label="Daily reports pages" hidden>
          <button class="quick-pager-btn" id="quickPagePrev" type="button" aria-label="Prev page" aria-disabled="true"><span aria-hidden="true">‹</span> Prev</button>
          <span class="quick-pager-info" id="quickPageInfo">Page 1 / 1</span>
          <button class="quick-pager-btn" id="quickPageNext" type="button" aria-label="Next page" aria-disabled="true">Next <span aria-hidden="true">›</span></button>
        </nav>
      </div>
      <div class="quick-view-panel" id="quickPanelWeek" role="tabpanel" aria-labelledby="quickTabWeek" hidden></div>
      <div class="quick-view-panel" id="quickPanelMonth" role="tabpanel" aria-labelledby="quickTabMonth" hidden></div>
    </div>
  </section>
  <div class="main-document" id="documentContent">
    <div class="loading"><span class="spinner" aria-hidden="true"></span><span>Loading private Markdown files…</span></div>
  </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
<script src="/assets/js/hachiware-reader.js"></script>
</body>
</html>
