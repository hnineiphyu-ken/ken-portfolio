<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KEN'S-MD</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; height: 100vh; height: 100dvh; background: #f5f6f8; color: #24292f; overflow-wrap: anywhere; }
.sidebar { width: 320px; height: 100vh; height: 100dvh; background: #fff; border-right: 1px solid #e1e4e8; overflow: hidden; padding: 0 16px max(14px, env(safe-area-inset-bottom, 14px)); flex-shrink: 0; display: flex; flex-direction: column; }
