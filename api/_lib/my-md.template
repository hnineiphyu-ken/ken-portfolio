.quick-view-tab { flex: 1 1 0; position: relative; border: 0; background: transparent; color: #57606a; font-family: inherit; font-size: 12.5px; font-weight: 600; line-height: 1; padding: 9px 10px; min-block-size: 34px; cursor: pointer; text-align: center; white-space: nowrap; transition: color .15s ease, background .15s ease; }
