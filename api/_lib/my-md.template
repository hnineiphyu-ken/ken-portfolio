.file-copy-btn.copied { color: #1a7f37 !important; }
.file-row a.active ~ .file-copy-btn.copied { color: #7ee787 !important; }
.tree { list-style: none; flex: 1; min-height: 0; overflow-y: auto; padding-bottom: 10px; }
.tree.collapsed { display: none; }
.tree li { margin: 2px 0; }
.tree .root-item.dragging { opacity: .55; }
.tree .root-item.drop-before { border-top: 3px solid #0969da; padding-top: 3px; }
.tree .root-item.drop-after { border-bottom: 3px solid #0969da; padding-bottom: 3px; }
.tree .root-row { font-size: 13px; color: #57606a; word-break: break-all; margin: 8px 0 4px; padding: 6px 8px; background: #f6f8fa; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.tree .root-row.selected { background: #e7f2ff; color: #075985; border: 1px solid #b6d7f5; }
.tree .single-file-row a { flex: 1; min-width: 0; }
.tree a { color: #24292f; text-decoration: none; font-size: 14px; display: block; padding: 4px 8px; border-radius: 6px; cursor: pointer; }
.tree a:hover { background: #f0f1f3; }
.tree a.active { background: #0969da; color: #fff; }
.tree .folder { font-weight: 600; padding: 4px 8px; color: #57606a; font-size: 13px; text-transform: uppercase; letter-spacing: .03em; user-select: none; cursor: pointer; border-radius: 6px; }
.tree .folder:hover { background: #f0f1f3; }
.tree .folder.selected-parent { background: #eaeef2; color: #424a53; }
.tree .folder::before { content: '▾'; display: inline-block; width: 14px; margin-right: 4px; transition: transform .15s ease; }
.tree .folder.collapsed::before { transform: rotate(-90deg); }
.tree .children { list-style: none; padding-left: 14px; border-left: 1px solid #e1e4e8; margin-left: 10px; }
.tree .children.collapsed { display: none; }
.tree .file-icon { opacity: .7; margin-right: 4px; }
.developer-credit { color: #57606a; font-size: 12px; text-align: center; background: #fff; border-top: 1px solid #e1e4e8; padding-top: 10px; flex-shrink: 0; }
.main { flex: 1; overflow-y: auto; padding: 32px 40px; }
.empty { color: #57606a; font-size: 16px; max-width: 600px; }
.error { color: #cf222e; background: #ffebe9; border: 1px solid #ffcecb; padding: 12px 16px; border-radius: 6px; font-size: 14px; word-break: break-all; }
.hint { font-size: 13px; color: #57606a; margin-top: 12px; line-height: 1.6; }
.loading { color: #57606a; background: #fff; border: 1px solid #e1e4e8; border-radius: 8px; padding: 24px 28px; display: inline-flex; align-items: center; gap: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
.spinner { width: 18px; height: 18px; border: 3px solid #d0d7de; border-top-color: #0969da; border-radius: 50%; animation: spin .75s linear infinite; flex-shrink: 0; }
@keyframes spin { to { transform: rotate(360deg); } }
.markdown { width: 100%; background: #fff; border: 1px solid #e1e4e8; border-radius: 8px; padding: 32px 40px; box-shadow: 0 1px 3px rgba(0,0,0,.04); line-height: 1.7; }
.markdown h1, .markdown h2, .markdown h3, .markdown h4 { margin: 28px 0 14px; line-height: 1.25; }
.markdown h1:first-child { margin-top: 0; }
.markdown p { margin: 0 0 16px; }
.markdown ul, .markdown ol { margin: 0 0 16px; padding-left: 28px; }
.markdown li { margin: 4px 0; }
.markdown code { background: #f0f1f3; padding: 2px 6px; border-radius: 4px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 13px; }
.markdown pre { background: #f6f8fa; border: 1px solid #e1e4e8; border-radius: 6px; padding: 16px; overflow-x: auto; margin: 0 0 16px; }
.markdown pre code { background: transparent; padding: 0; }
.markdown blockquote { border-left: 4px solid #d0d7de; margin: 0 0 16px; padding: 0 16px; color: #57606a; }
.markdown a { color: #0969da; }
.markdown table { border-collapse: collapse; margin: 0 0 16px; }
.markdown th, .markdown td { border: 1px solid #d0d7de; padding: 6px 12px; }
.markdown img { max-width: 100%; }
.markdown hr { border: 0; border-top: 1px solid #e1e4e8; margin: 24px 0; }
.markdown del { color: #57606a; }
.markdown img { max-width: 100%; height: auto; border-radius: 6px; margin: 8px 0; }
.markdown .task-list { list-style: none; padding-left: 4px; }
.markdown .task-list li { display: flex; align-items: flex-start; gap: 8px; margin: 6px 0; }
.markdown .task-list input[type="checkbox"] { margin-top: 5px; accent-color: #0969da; flex-shrink: 0; }
