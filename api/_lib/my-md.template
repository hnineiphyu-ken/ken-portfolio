.quick-pager-info { font-size: 12px; color: #57606a; font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
.quick-period-nav { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 14px; border-top: 1px solid #e1e4e8; background: #fff; }
