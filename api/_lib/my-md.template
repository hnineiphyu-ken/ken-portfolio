.quick-filter-clear[hidden] { display: none; }
.quick-reports-list { list-style: none; padding: 6px 10px 8px; border-top: 1px solid #e1e4e8; background: #fff; display: flex; flex-direction: column; gap: 3px; }
.quick-pager { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 14px; border-top: 1px solid #e1e4e8; background: #f6f8fa; }
