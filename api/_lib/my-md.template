@media (max-width: 1023px) {
body { display: block; }
.menu-btn { display: block; }
.sidebar { position: fixed; top: 0; left: 0; z-index: 4; width: min(320px, 86vw); height: 100vh; height: 100dvh; transform: translateX(-100%); transition: transform .22s ease; box-shadow: 8px 0 24px rgba(31,35,40,.18); }
body.sidebar-closed .sidebar { display: flex; }
body.sidebar-open .sidebar { transform: translateX(0); }
